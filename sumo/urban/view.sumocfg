<configuration>
    <input>
        <net-file value="urban.net.xml"/>
        <route-files value="routes_view_burst.rou.xml"/>
    </input>
    <time>
        <begin value="0"/>
        <end value="120"/>
        <step-length value="1.0"/>
    </time>
