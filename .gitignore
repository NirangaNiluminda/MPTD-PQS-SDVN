# Ignore everything


# ── Core NS-3 simulation code (C++ codebase) ──────────────────────────────────
!analytics/
!scratch/
!analytics/**
!scratch/**

# ── FYP Python framework ──────────────────────────────────────────────────────
!mptd_pqs/
!mptd_pqs/**
mptd_pqs/__pycache__/
mptd_pqs/**/*.pyc
!mptd_pqs_pipeline.py
!attack_comparison.py
!mptd_pqs_results.json
!global_baseline_eval.py
!global_heldout_eval.py
!GLOBAL_BASELINE_README.md
# ── Baseline hand-off (train-here / eval-on-real-data-there) ──────────────────
!train_global_models.py
!eval_on_real_and_plot.py
!README_HANDOFF.md
!requirements.txt

# Frozen trained models — committed so the teammate gets them from the branch
!models_global/
!models_global/**

# ── Mobility trace files ──────────────────────────────────────────────────────
!mobility/
!mobility/**
mobility/**/*.bak

# ── SUMO pipeline: allowlist source .osm, built .net.xml, and the build script;
#    re-ignore regeneratable intermediates (rebuilt by sumo/build_sumo_trace.sh) ─
!sumo/
!sumo/**
sumo/**/fcd*.xml
sumo/**/trips.xml
sumo/**/trips_*.xml
sumo/**/routes.rou.xml
sumo/**/routes.rou.alt.xml
sumo/**/routes_*.rou.xml
sumo/**/routes_*.rou.alt.xml
sumo/**/*_full.net.xml
sumo/**/keep_edges.txt
sumo/**/mobility_*.tcl

# ── Hyperledger Fabric chaincode (Go) ─────────────────────────────────────────
# imported May 2026 from NirangaNiluminda/mptd-pqs-blockchain → ns3 chaincode/
# vendor/ is kept under tracking so chaincode builds hermetically inside the
# CCAAS Docker image (Dockerfile assumes vendor/ is populated; no network at
# container-build time). Regenerable via `cd chaincode && go mod vendor`.
!chaincode/
!chaincode/**
chaincode/**/*.test

# ── Root config / build files ─────────────────────────────────────────────────
!.gitignore
!wscript

# ── Ignore large generated outputs even inside allowed folders ─────────────────
scratch/*.log
scratch/*.tr
scratch/*.pcap
scratch/*.txt
scratch/lda_attack_output.txt
analytics/data/*.csv
analytics/data/optimization_data.csv

# ── Keep these specific CSVs (manually maintained, not auto-generated) ─────────
!analytics/data/security_nodepair_AES_data.csv

# ── Ignore compiled objects inside scratch ────────────────────────────────────
scratch/**/*.o
scratch/**/*.a

# ── ML pipeline: ignore generated/binary artefacts ───────────────────────────
analytics/ml/__pycache__/
analytics/ml/**/__pycache__/
analytics/ml/**/*.pyc
analytics/ml/models/

# ── Stage 8: ignore auto-generated evaluation outputs ─────────────────────────
analytics/results/figures/
analytics/results/sweep/
analytics/results/logs/

# ── Per-run sim artefacts (regenerated every run; not source) ─────────────────
analytics/results/mptd_netanim_*.xml
analytics/results/*_log.csv
analytics/results/*_log_attack*.csv
analytics/results/runs/

# ── Compiled Fabric gateway daemon binary (built from main.go) ────────────────
scratch/mptd_pqs_sdvn/fabric_gateway_daemon/mptd_fabric_gw

# ── SUMO autobahn intermediates (regenerated by build_sumo_trace.sh) ──────────
sumo/**/mwbias.*.xml
sumo/**/corridor_*.txt

# ── Generated training datasets (per-scenario CSVs + zip bundle) — regeneratable
#    by the Phase-A sims; not source, kept out of git. ──────────────────────────
analytics/datasets/
analytics/datasets.zip

# ── Per-run logs inside the sim scratch dir (the top-level `scratch/*.log` rule
#    above does not reach the mptd_pqs_sdvn/ subdir). ───────────────────────────
scratch/mptd_pqs_sdvn/*.log
# Virtual environments
.venv/
venv/
ENV/
.env

# Generated evaluation and plot folders
real_data/
results/
live_results/
lstm_detector/
analytics/ml/plots/
analytics/ml/data/beacon_clean_*.csv

# ── gat_detector generated artifacts (dir is not otherwise ignored) ───────────
gat_detector/outputs/
gat_detector/__pycache__/
gat_detector/**/*.pyc
gat_detector/.venv/
gat_detector/data/

# ── Local backups, experimental scans & archives (never committed; regeneratable) ─
# Canonical maps/traces live at sumo/<scenario>/ and mobility/mobility_<scenario>_<spd>.tcl;
# everything below is scratch produced while building them.
**/*.bak*
**/*.grid*
lstm_detector.zip
analytics/_archive_*/
sumo/manching/
sumo/manching3k/
sumo/rural3k/
sumo/ruralbig/
sumo/**/keepin.add.xml
mobility/mobility_manching*.tcl
mobility/mobility_rural3k_*.tcl




# Python bytecode (any depth)
__pycache__/

# ── ns-3 RLC/PHY trace dumps (regenerated whenever the binary is run from the
