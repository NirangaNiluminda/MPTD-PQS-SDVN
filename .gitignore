# Ignore everything
*

# ── Core NS-3 simulation code (C++ codebase) ──────────────────────────────────
!analytics/
!scratch/
!analytics/**
!scratch/**

# ── FYP Python framework ──────────────────────────────────────────────────────
!mptd_pqs/
!mptd_pqs/**
mptd_pqs/__pycache__/
mptd_pqs/**/*.pyc
!mptd_pqs_pipeline.py
!attack_comparison.py
!mptd_pqs_results.json

# ── Mobility trace files ──────────────────────────────────────────────────────
!mobility/
!mobility/**

# ── SUMO pipeline: allowlist source .osm, built .net.xml, and the build script;
#    re-ignore regeneratable intermediates (rebuilt by sumo/build_sumo_trace.sh) ─
!sumo/
!sumo/**
sumo/**/fcd.xml
sumo/**/fcd_shifted.xml
sumo/**/trips.xml
sumo/**/routes.rou.xml
sumo/**/routes.rou.alt.xml
sumo/**/mobility_*.tcl

# ── Hyperledger Fabric chaincode (Go) ─────────────────────────────────────────
# imported May 2026 from NirangaNiluminda/mptd-pqs-blockchain → ns3 chaincode/
# vendor/ is kept under tracking so chaincode builds hermetically inside the
# CCAAS Docker image (Dockerfile assumes vendor/ is populated; no network at
# container-build time). Regenerable via `cd chaincode && go mod vendor`.
!chaincode/
!chaincode/**
chaincode/**/*.test

# ── Root config / build files ─────────────────────────────────────────────────
!.gitignore
!wscript

# ── Ignore large generated outputs even inside allowed folders ─────────────────
scratch/*.log
scratch/*.tr
scratch/*.pcap
scratch/*.txt
scratch/lda_attack_output.txt
analytics/data/*.csv
analytics/data/optimization_data.csv

# ── Keep these specific CSVs (manually maintained, not auto-generated) ─────────
!analytics/data/security_nodepair_AES_data.csv

# ── Ignore compiled objects inside scratch ────────────────────────────────────
scratch/**/*.o
scratch/**/*.a

# ── ML pipeline: ignore generated/binary artefacts ───────────────────────────
analytics/ml/__pycache__/
analytics/ml/**/__pycache__/
analytics/ml/**/*.pyc
analytics/ml/models/

# ── Stage 8: ignore auto-generated evaluation outputs ─────────────────────────
analytics/results/figures/
analytics/results/sweep/
analytics/results/logs/
